# ───────────────────────────────────────────────────────────
#  BASE DE DONNÉES PostgreSQL
# ───────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio?schema=public"

# ───────────────────────────────────────────────────────────
#  SÉCURITÉ (JWT)
#  Génère une longue chaîne aléatoire : openssl rand -hex 32
# ───────────────────────────────────────────────────────────
JWT_SECRET="remplace-moi-par-une-longue-chaine-aleatoire"
JWT_EXPIRES_IN="7d"

# ───────────────────────────────────────────────────────────
#  COMPTE ADMINISTRATEUR (créé automatiquement au "npm run seed")
# ───────────────────────────────────────────────────────────
ADMIN_EMAIL="compaoreguetawendezacharie@gmail.com"
ADMIN_PASSWORD="change-moi-vite"

# ───────────────────────────────────────────────────────────
#  SERVEUR
# ───────────────────────────────────────────────────────────
PORT=4000
CORS_ORIGIN="http://localhost:5173"
PUBLIC_URL="http://localhost:4000"

# ───────────────────────────────────────────────────────────
#  SMTP GMAIL  —  À REMPLIR pour recevoir les messages du formulaire
#
#  Gmail :
#    1) Active la validation en 2 étapes sur ton compte Google
#    2) Crée un "mot de passe d'application" (16 caractères)
#    3) Renseigne ci-dessous :
#         SMTP_HOST=smtp.gmail.com
#         SMTP_PORT=465
#         SMTP_SECURE=true
#         SMTP_USER=ton.email@gmail.com
#         SMTP_PASS=le-mot-de-passe-application
#         CONTACT_TO=adresse.qui.recoit@gmail.com
#
#  Laissé VIDE volontairement — remplis-le toi-même.
# ───────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
CONTACT_TO=
